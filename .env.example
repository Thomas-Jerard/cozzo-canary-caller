# Meta Model API key.
# The docs call this variable MODEL_API_KEY (https://dev.meta.ai/docs/quickstart).
# Canary Caller reads MUSE_API_KEY. Leave it empty to run in mock mode.
MUSE_API_KEY=

# Optional override. The documented default is https://api.meta.ai/v1
# MUSE_BASE_URL=https://api.meta.ai/v1
